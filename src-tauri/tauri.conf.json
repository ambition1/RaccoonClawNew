{
  "$schema": "https://v2.tauri.app/v2/schemas/config.schema.json",
  "productName": "RaccoonClaw",
  "version": "1.0.0",
  "identifier": "com.raccoonclaw.oss",
  "build": {
    "devtools": true
  },
  "app": {
    "windows": [
      {
        "title": "RaccoonClaw OSS",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "http://localhost:7891"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
